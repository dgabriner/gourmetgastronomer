---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { buildGraph, placesByKind } from "../../lib/graph";

const pages = await getCollection("pages");
const sources = await getCollection("sources");
const { nodes } = buildGraph(pages, sources);
const bakeries = placesByKind("bakery", nodes.values());
---
<Base
  title="Bakeries — Atlas — Gourmet Gastronomer"
  description="Bakeries in the Gourmet Gastronomer atlas."
  permalink="/atlas/bakeries/"
  crumbs={[
    { name: "Atlas", url: "/atlas/" },
    { name: "Bakeries", url: "/atlas/bakeries/" },
  ]}
  currentNav="atlas"
>
  <main class="home" id="main">
    <p class="eyebrow">Atlas</p>
    <h1>Bakeries</h1>
    <p class="lede">Craft practiced in a real place, by real people, with local flour and heat.</p>
    <ul class="place-list">
      {bakeries.map((item) => (
        <li>
          <a href={item.url}>{item.data.title}</a>
          <span>{item.data.summary}</span>
        </li>
      ))}
    </ul>
  </main>
</Base>
