---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { buildGraph, nodesByKind } from "../../lib/graph";

const pages = await getCollection("pages");
const sources = await getCollection("sources");
const { nodes } = buildGraph(pages, sources);
const ingredients = nodesByKind("ingredient", nodes.values());
---
<Base
  title="Ingredients — Catalog — Gourmet Gastronomer"
  description="Ingredient pages in Gourmet Gastronomer."
  permalink="/catalog/ingredients/"
  crumbs={[
    { name: "Catalog", url: "/catalog/" },
    { name: "Ingredients", url: "/catalog/ingredients/" },
  ]}
  currentNav="catalog"
>
  <main class="home" id="main">
    <p class="eyebrow">Catalog</p>
    <h1>Ingredients</h1>
    <ul class="catalog-list">
      {ingredients.map((item) => (
        <li>
          <a href={item.url}>{item.data.title}</a>
          {" — "}
          {item.data.summary}
        </li>
      ))}
    </ul>
  </main>
</Base>
