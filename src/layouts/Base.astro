---
import "../styles/global.css";
import Illustration from "../components/Illustration.astro";
import {
  breadcrumbJsonLd,
  canonicalUrl,
  CC_BY_40,
  jsonLdScript,
  organizationJsonLd,
  websiteJsonLd,
} from "../lib/jsonld";

interface Props {
  title: string;
  description: string;
  permalink: string;
  crumbs?: { name: string; url: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  currentNav?: string;
  includeWebsite?: boolean;
  skipSectionNav?: boolean;
  ogType?: "website" | "article";
  shareImage?: string | null;
}

const {
  title,
  description,
  permalink,
  crumbs = [],
  jsonLd = null,
  currentNav,
  includeWebsite = false,
  skipSectionNav = true,
  ogType = "website",
  shareImage = "/og.png",
} = Astro.props;

const canonical = canonicalUrl(permalink);
const socialImage = shareImage ? canonicalUrl(shareImage) : null;
const gsc = import.meta.env.GSC_VERIFICATION;
const jsonBlocks: Record<string, unknown>[] = [organizationJsonLd()];
if (includeWebsite) jsonBlocks.push(websiteJsonLd());
if (crumbs.length) {
  jsonBlocks.push(
    breadcrumbJsonLd([
      { name: "Gourmet Gastronomer", url: "/" },
      ...crumbs,
    ]),
  );
}
if (jsonLd) {
  jsonBlocks.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Google tag (gtag.js) — gourmetgastronomer.com GA4 G-VHKXQ1LFW8 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VHKXQ1LFW8"></script>
    <script
      is:inline
      set:html={"window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-VHKXQ1LFW8');"}
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#f6f1e8" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Gourmet Gastronomer" href="/feed.xml" />
    <link rel="describedby" href="/llms.txt" />
    <link rel="license" href={CC_BY_40} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Gourmet Gastronomer" />
    <meta property="og:locale" content="en_US" />
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Gourmet Gastronomer — a food encyclopedia" />
      </>
    )}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && (
      <>
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content="Gourmet Gastronomer — a food encyclopedia" />
      </>
    )}
    {jsonBlocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={jsonLdScript(block)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <div class="skip-links">
      <a href="#main">Skip to content</a>
      <a href="#search">Skip to search</a>
      {!skipSectionNav && (
        <a href="#section-nav">Skip to section nav</a>
      )}
    </div>
    <div class="masthead-bar">
      <header class="masthead-wrap">
        <div class="masthead">
          <a class="wordmark" href="/">
            <Illustration name="mark" decorative class="wordmark-mark" />
            <span class="wordmark-text">
              <span>Gourmet</span>
              <small>Gastronomer</small>
            </span>
          </a>
          <details class="nav-toggle">
            <summary>Menu</summary>
            <div class="nav-panel">
              <nav class="primary-nav" aria-label="Main">
                <a href="/baking/" aria-current={currentNav === "baking" ? "page" : undefined}>Baking</a>
                <a href="/atlas/" aria-current={currentNav === "atlas" ? "page" : undefined}>Atlas</a>
                <a href="/learn/" aria-current={currentNav === "learn" ? "page" : undefined}>Learn</a>
                <a href="/catalog/" aria-current={currentNav === "catalog" ? "page" : undefined}>Catalog</a>
                <a href="/search/" aria-current={currentNav === "search" ? "page" : undefined}>Search</a>
              </nav>
            </div>
          </details>
          <nav class="primary-nav" aria-label="Main" data-desktop-nav>
            <a href="/baking/" aria-current={currentNav === "baking" ? "page" : undefined}>Baking</a>
            <a href="/atlas/" aria-current={currentNav === "atlas" ? "page" : undefined}>Atlas</a>
            <a href="/learn/" aria-current={currentNav === "learn" ? "page" : undefined}>Learn</a>
            <a href="/catalog/" aria-current={currentNav === "catalog" ? "page" : undefined}>Catalog</a>
            <a href="/search/" aria-current={currentNav === "search" ? "page" : undefined}>Search</a>
          </nav>
          <form id="search" class="search-link" action="/search/" method="get" role="search">
            <Illustration name="search" decorative />
            <label class="visually-hidden" for="q">Search the encyclopedia</label>
            <input id="q" name="q" type="search" placeholder="Search the encyclopedia" />
          </form>
        </div>
      </header>
    </div>
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {crumbs.map((crumb, index) => (
            <li>
              {index === crumbs.length - 1 ? (
                <span aria-current="page">{crumb.name}</span>
              ) : (
                <a href={crumb.url}>{crumb.name}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <nav aria-label="Help">
          <a href="/how-to-read/">How to use this site</a>
          <a href="/method/">Method</a>
          <a href="/editorial/">Editorial standards</a>
          <a href="/corrections/">Corrections</a>
          <a href="/reuse/">Reuse</a>
          <a href="/catalog/">Glossary</a>
          <a href="/catalog/sources/">Sources</a>
          <a href="/about/">About</a>
          <a href="/sour-flour/">Gourmet Gastronomer + Sour Flour</a>
        </nav>
        <p class="footer-note">
          A working encyclopedia of food. Original prose is
          <a href="/reuse/">CC BY 4.0</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
